# Copy this file to .env.local and fill in the real values.
# .env.local is gitignored. On Vercel, set the same keys under
# Settings > Environment Variables. Never commit real values.

# Supabase > Project Settings > Data API > Project URL
SUPABASE_URL=https://your-project.supabase.co

# Supabase > Project Settings > API Keys > "Secret keys" (starts with sb_secret_).
# In the older key scheme this was called the service_role key. It bypasses row
# level security, so it is server only. There is deliberately no NEXT_PUBLIC_
# prefix: that prefix would ship the key to every visitor's browser.
#
# Do NOT use the publishable key (sb_publishable_) here. That one respects RLS,
# and the orders table grants nothing to public roles, so it would read nothing.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# Password for /admin/login. Pick something long and random.
ADMIN_PASSWORD=your-admin-password

# Signs the admin session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing this immediately logs out every admin session.
ADMIN_SESSION_SECRET=your-random-32-byte-hex
